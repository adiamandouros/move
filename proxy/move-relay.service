# systemd service for the home relay (proxy/node.js) — see README.md, "Home relay".
# Install: sudo cp proxy/move-relay.service /etc/systemd/system/
#          sudo systemctl enable --now move-relay
[Unit]
Description=Move OASA relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/move/proxy/node.js
# RELAY_KEY=... (and optionally PORT=...)
EnvironmentFile=/etc/move-relay.env
Restart=always
RestartSec=5
# Runs as a throwaway user that can't write anywhere
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
