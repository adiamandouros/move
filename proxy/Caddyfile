# Caddy config for the home relay — see README.md, "Home relay".
# Install: sudo cp proxy/Caddyfile /etc/caddy/Caddyfile
# and replace YOUR-NAME.ddns.net with the home's DDNS name.
#
# Router port forwarding this expects (many ISP routers keep 443, and the Pi's
# own port 80 is often taken, e.g. by Pi-hole's admin page):
#   external TCP 80   → this machine's 8081  Let's Encrypt checks the name here
#   external TCP 8443 → this machine's 443   the relay itself (HTTPS)
# The server then uses OASA_HOME_RELAY_URL=https://YOUR-NAME.ddns.net:8443/
{
	# Caddy's plain-HTTP port, which answers Let's Encrypt's checks
	http_port 8081
}

YOUR-NAME.ddns.net {
	# External 443 doesn't reach this machine, so only the port-80 check works
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# Optional: only the Move server may connect (its IP is shown on
	# /admin/diagnostics under "Internet access"). Update it if the host moves.
	# @others not remote_ip 157.90.210.32
	# abort @others

	reverse_proxy 127.0.0.1:8787
}
