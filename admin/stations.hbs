<div class="admin-view">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <h1 class="fs-5 m-0">Station editor</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" href="/admin/diagnostics" title="Diagnostics" aria-label="Diagnostics">
                {{icon "health"}}
            </a>
            {{!-- The files with every edit, ready to commit --}}
            <details class="export-menu">
                <summary class="btn btn-sm btn-outline-secondary">{{icon "download" "me-1"}}Export</summary>
                <div class="export-files">
                    <a class="btn btn-sm btn-outline-secondary" href="/admin/api/export/positions.json" download>positions.json</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/admin/api/export/street.json" download>street.json</a>
                </div>
            </details>
            <form method="post" action="/admin/logout">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Log out</button>
            </form>
        </div>
    </div>

    <div id="sync-status" class="sync-status" role="status" hidden></div>
    <p id="load-error" class="text-danger small" role="alert" hidden></p>

    <div class="admin-pickers">
        <div id="line-picker" class="picker-row" role="group" aria-label="Line"></div>
        <div id="dir-picker" class="picker-row" role="group" aria-label="Direction"></div>
        <div class="d-flex gap-2">
            <label for="station-picker" class="sr-only">Station</label>
            <select id="station-picker" class="form-select"></select>
            <button id="nearest-btn" type="button" class="btn btn-outline-primary" title="Nearest station" aria-label="Nearest station">
                {{icon "nearest"}}
            </button>
        </div>
    </div>

    <form id="entry-form" class="entry-form" hidden>
        <h2 class="entry-part">This platform</h2>
        <p id="entry-state" class="entry-state"></p>
        <p id="entry-missing" class="entry-missing" hidden></p>

        <fieldset>
            <legend>Exits</legend>
            <div class="car-toggles" data-field="exits"></div>
        </fieldset>

        <fieldset>
            <legend>Elevators</legend>
            <div class="elevators-known">
                <div class="form-check form-check-inline">
                    <input id="elevators-unknown" class="form-check-input" type="radio" name="elevators-known" value="">
                    <label for="elevators-unknown" class="form-check-label">Not known yet</label>
                </div>
                <div class="form-check form-check-inline">
                    <input id="elevators-none" class="form-check-input" type="radio" name="elevators-known" value="none">
                    <label for="elevators-none" class="form-check-label">No elevator</label>
                </div>
                <div class="form-check form-check-inline">
                    <input id="elevators-list" class="form-check-input" type="radio" name="elevators-known" value="list">
                    <label for="elevators-list" class="form-check-label">Elevators</label>
                </div>
            </div>
            {{!-- Disabled while hidden, so a row left half filled doesn't stop a save --}}
            <fieldset id="elevator-list" class="list" aria-label="Elevators on this platform">
                <div id="elevator-rows"></div>
                <button id="add-elevator" type="button" class="btn btn-sm btn-outline-primary">Add elevator</button>
            </fieldset>
            <datalist id="stasy-lifts"></datalist>
        </fieldset>

        <fieldset>
            <legend>Escalators up</legend>
            <div class="car-toggles" data-field="escalators"></div>
        </fieldset>

        <fieldset>
            <legend>Stairs</legend>
            <div class="car-toggles" data-field="stairs"></div>
        </fieldset>

        <div class="form-check form-switch mb-3">
            <input id="central-platform" class="form-check-input" type="checkbox" role="switch">
            <label for="central-platform" class="form-check-label">Central platform (exit on the left)</label>
        </div>

        <label for="step-free" class="form-label">Step-free from the street (this platform)</label>
        <select id="step-free" class="form-select mb-3">
            <option value="">Not known yet</option>
            <option value="lift">Yes, by elevator</option>
            <option value="ramp">Yes, by ramp</option>
            <option value="level">Yes, on the level</option>
            <option value="yes">Yes (how not recorded)</option>
            <option value="no">No: steps only</option>
        </select>

        <div id="transfers"></div>

        <label for="note" class="form-label">Note</label>
        <textarea id="note" class="form-control mb-3" rows="2" maxlength="500"></textarea>

        {{!-- In street.json; left out with an older copy of the data, from before it --}}
        <div id="street-part">
            <h2 class="entry-part">Whole station</h2>
            <p class="entry-state">The same for every line and direction here.</p>
            <p id="street-state" class="entry-state"></p>
            <p id="street-missing" class="entry-missing" hidden></p>

            <fieldset>
                <legend>Exits to the street</legend>
                <div id="street-exit-rows"></div>
                <button id="add-street-exit" type="button" class="btn btn-sm btn-outline-primary">Add exit</button>
            </fieldset>

            <fieldset>
                <legend>Elevators to the street</legend>
                <div id="street-lift-rows"></div>
                <button id="add-street-lift" type="button" class="btn btn-sm btn-outline-primary">Add street elevator</button>
            </fieldset>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Save</button>
            <button id="revert-platform" type="button" class="btn btn-outline-warning">Revert platform</button>
            <button id="revert-station" type="button" class="btn btn-outline-warning">Revert station</button>
        </div>
        <p id="entry-message" class="small mt-2" role="status"></p>
    </form>
</div>
