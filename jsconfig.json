{
    // npm run typecheck: TypeScript checks the files that start with
    // // @ts-check against the JSDoc types in them and in types/. Nothing is
    // compiled; the app runs the same JavaScript. Editors use this file too.
    "compilerOptions": {
        "target": "es2023",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2023", "dom", "dom.iterable"],
        "types": ["node"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": ["server.js", "server/**/*.js", "tools/*/client/**/*.js", "public/js/**/*.js", "types/**/*.d.ts"],
    "exclude": ["server/views/sw.js"]
}
