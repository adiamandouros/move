{{!-- What search engines and link previews see (seo.js, pageMeta) --}}
{{#if index}}
    <meta name="description" content="{{description}}">
{{#if url}}
    <link rel="canonical" href="{{url}}">
{{#each alternates}}
    <link rel="alternate" hreflang="{{lang}}" href="{{href}}">
{{/each}}
{{/if}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Wayhop">
    <meta property="og:locale" content="{{locale}}">
{{#each otherLocales}}
    <meta property="og:locale:alternate" content="{{this}}">
{{/each}}
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
{{#if url}}
    <meta property="og:url" content="{{url}}">
    <meta property="og:image" content="{{image}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Wayhop: live buses and metro in Athens">
{{/if}}
    <meta name="twitter:card" content="summary_large_image">
{{else}}
    <meta name="robots" content="noindex">
{{/if}}
