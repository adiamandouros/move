<img src="/icon/logo.svg" alt="" width="{{width}}" height="{{height}}" class="logo-on-dark{{#if class}} {{class}}{{/if}}"><img src="/icon/logo-light.svg" alt="" width="{{width}}" height="{{height}}" class="logo-on-light{{#if class}} {{class}}{{/if}}">