{{!-- Auto, Light and Dark (/js/core/theme.js shows it and marks the choice) --}}
<div class="theme-switch" role="group" aria-label="{{t "theme.label"}}" hidden>
    <button type="button" data-theme-choice="auto" aria-pressed="false">{{t "theme.auto"}}</button>
    <button type="button" data-theme-choice="light" aria-pressed="false">{{t "theme.light"}}</button>
    <button type="button" data-theme-choice="dark" aria-pressed="false">{{t "theme.dark"}}</button>
</div>
