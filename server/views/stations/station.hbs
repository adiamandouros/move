{{!-- A metro station's page (server/pages/stations.js, stationView) --}}
<div class="station-view">
{{> breadcrumb crumbs}}
    {{!-- The star at the far right of the sign's line, or under it (/js/core/station-title.js, from shell.js) --}}
    <div class="station-title">
        <h1 class="station-name">{{sign}}</h1>
        {{favourite}}
    </div>
    <p class="text-body-secondary mb-3">{{t "stations.lines-here"}}{{#each lines}} {{badge}}{{/each}}</p>
    {{!-- Its lifts out of service, if any, as STASY says (/js/core/lifts.js, from shell.js) --}}
    <div id="lift-status" aria-live="polite" data-station="{{id}}" data-name="{{name}}"></div>
    <div class="station-actions d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-sm btn-outline-primary rounded-pill" href="/subway?from={{id}}">{{icon "trip-from" "me-1"}}{{t "stations.plan-from"}}</a>
        <a class="btn btn-sm btn-outline-primary rounded-pill" href="/subway?to={{id}}">{{icon "trip-to" "me-1"}}{{t "stations.plan-to"}}</a>
        {{#external href=walking class="btn btn-sm btn-outline-secondary rounded-pill"}}{{icon "walk" "me-1"}}{{t "stations.walk"}}{{/external}}
    </div>
    {{!-- Each card names its line: no heading per line --}}
    <div class="station-section">
{{#each lines}}
{{#each directions}}
        {{> station-direction}}
{{/each}}
{{/each}}
    </div>
{{#if legend}}
    {{legend}}
{{/if}}
{{#if timetable.stasy}}
    <p class="schedule-disclaimer">{{icon "info" "me-1"}}{{t "stations.timetable-stasy" date=timetable.stasy}}</p>
{{/if}}
{{#if timetable.gtfs}}
    <p class="schedule-disclaimer">{{icon "info" "me-1"}}{{#if timetable.gtfs.old}}{{t "stations.timetable-old" date=timetable.gtfs.date}}{{else}}{{t "stations.timetable" date=timetable.gtfs.date}}{{/if}}</p>
{{/if}}
</div>
