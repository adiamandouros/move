{{!-- Every station of a network by line: the metro's (server/pages/stations.js,
indexView), the tram's or the suburban railway's (network-stations.js) --}}
<div class="station-view">
{{> breadcrumb crumbs}}
    <h1 class="fw-semibold mb-2">{{title}}</h1>
    <p class="text-body-secondary">{{intro}}</p>
{{#each lines}}
    <section class="station-section" aria-labelledby="line-{{key}}">
        <h2 class="station-line-title" id="line-{{key}}">{{heading}}<span class="sr-only"> {{t "stations.line" n=number}}</span></h2>
        <ol class="station-stops">
{{#each stops}}
            <li><a href="{{href}}">{{name}}</a>{{#if changes}} <span class="station-change">· {{t "stations.interchange" lines=changes}}</span>{{/if}}</li>
{{/each}}
        </ol>
    </section>
{{/each}}
    <p class="station-index-link small">{{t "stations.see-also"}}{{#each seeAlso}}{{#if @index}} ·{{/if}} <a href="{{href}}">{{name}}</a>{{/each}}</p>
</div>
