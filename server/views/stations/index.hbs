{{!-- Every metro station by line (server/pages/stations.js, indexView) --}}
<div class="station-view">
{{> breadcrumb crumbs}}
    <h1 class="fw-semibold mb-2">{{t "stations.title"}}</h1>
    <p class="text-body-secondary">{{t "stations.index-intro"}}</p>
{{#each lines}}
    <section class="station-section" aria-labelledby="line-{{key}}">
        <h2 class="station-line-title" id="line-{{key}}">{{badge}} {{t "stations.line" n=number}}</h2>
        <ol class="station-stops">
{{#each stops}}
            <li><a href="{{href}}">{{name}}</a>{{#if changes}} <span class="station-change">· {{t "stations.interchange" lines=changes}}</span>{{/if}}</li>
{{/each}}
        </ol>
    </section>
{{/each}}
</div>
