{{!-- Home (decision 81): Wayhop's name and whether anything's disrupted,
      where to, the starred stations, and what's near you now; filled in by
      /js/core/announcements.js and /js/core/home.js --}}
<div class="home-view">
    <div class="home-top">
        <h1 class="home-brand"><span class="home-wordmark" aria-hidden="true">{{> logo width=30 height=22}}<span>wayhop<span class="brand-dot">.</span></span></span><span class="sr-only">{{t "home.title"}}</span></h1>
        <div id="home-status" class="home-status"></div>
    </div>

    <div id="disruptions" aria-live="polite"></div>

    <a href="/trip" data-tool="trip" class="home-where">{{icon "trip-to"}}<span>{{t "near.where"}}</span></a>

    <ul id="home-stars" class="home-stars list-unstyled" aria-label="{{t "near.stars"}}" hidden></ul>

    <section class="home-near" aria-labelledby="near-title">
        <h2 id="near-title" class="near-label">{{t "near.near"}}</h2>
        <div id="near-you" aria-live="polite">
            <noscript><p class="text-body-secondary">{{t "near.near-ask"}}</p></noscript>
        </div>
    </section>

    <!-- Shown by /js/core/install.js where the browser can install the app -->
    <section id="install" class="card install-card" aria-labelledby="install-title" hidden>
        {{> logo width=44 height=32 class="install-logo"}}
        <div class="install-body">
            <h2 id="install-title" class="install-title">{{t "install.title"}}</h2>
            <p class="install-text">{{t "install.text"}}</p>
            <p id="install-ios" class="install-text" hidden>{{t "install.ios"}}</p>
            <button type="button" id="install-btn" class="btn btn-primary btn-sm rounded-pill px-4" hidden>{{t "install.button"}}</button>
        </div>
        <button type="button" id="install-close" class="install-close" aria-label="{{t "install.dismiss"}}">{{icon "close"}}</button>
    </section>
</div>
