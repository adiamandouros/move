{{!-- The layout around every page (server/pages/layout.js) --}}
<!DOCTYPE html>
<html lang="{{lang}}" data-bs-theme="dark" data-icons="{{icons}}"{{#if other}} data-other-lang="{{other.lang}}" data-other-path="{{other.path}}"{{/if}}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{{#if other}}
    {{!-- Someone who chose the other language with the language link
    (remembered by /js/core/shell.js) gets this page in it before it shows.
    The same on every page, so the Content-Security-Policy allows it by one
    hash (server/csp.js). --}}
    <script>
        try { var root = document.documentElement; if (localStorage.getItem('language') === root.dataset.otherLang) location.replace(root.dataset.otherPath + location.search + location.hash); } catch (e) {}
    </script>
{{/if}}
    <title>{{title}} — Wayhop</title>
{{> meta seo}}
{{#if adsenseClient}}
    {{!-- Tells AdSense which account the site belongs to (its site review checks for it) --}}
    <meta name="google-adsense-account" content="{{adsenseClient}}">
{{/if}}
    <meta name="theme-color" content="#161b27">
    {{!-- The colour mode the phone or the person chose, before anything is drawn
    (/js/core/theme.js). The same on every page, so the Content-Security-Policy
    allows it by one hash (server/csp.js). --}}
    <script>{{{themeScript}}}</script>
    <script type="importmap">{{json importMap}}</script>
{{#each fonts}}
    <link rel="preload" href="{{this}}" as="font" type="font/woff2" crossorigin>
{{/each}}
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/icon/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/icon/favicon.svg">
    <link rel="shortcut icon" href="/icon/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/icon/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="Wayhop">
    <link rel="manifest" href="{{manifest}}">
{{#each styles}}
    <link rel="stylesheet" href="{{this}}">
{{/each}}
{{#if structuredData}}
    <script type="application/ld+json">{{json structuredData}}</script>
{{/if}}
</head>
<body>

    <a href="#app-content" class="skip-link">{{t "shell.skip"}}</a>

    <div id="layout">

        <!-- Sidebar (desktop) -->
        <nav id="side-nav" class="d-none d-md-flex flex-column border-end" aria-label="{{t "nav.main"}}">
            <div class="side-nav-brand px-3 py-4">
                <a href="/" class="brand-link text-decoration-none">{{> logo width=38 height=28}}<span>wayhop<span class="brand-dot" aria-hidden="true">.</span></span></a>
            </div>
            <div class="d-flex flex-column flex-grow-1 px-2">
{{#each tools}}
                <a href="{{path}}" data-tool="{{id}}" class="nav-btn btn d-flex align-items-center gap-3 px-3 py-3 mb-1{{#if active}} active{{/if}}"{{#if active}} aria-current="page"{{/if}}>{{#if active}}{{icon iconName "icon-nav" filled=true}}{{else}}{{icon iconName "icon-nav"}}{{/if}}<span>{{t titleKey}}</span></a>
{{/each}}
                <div class="mt-auto pb-3">
                    {{> theme-switch}}
                    {{!-- The pages about the site, stacked above the language link at the bottom --}}
                    <div class="side-links">
{{#each siteLinks}}
                        <a href="{{href}}">{{t textKey}}</a>
{{/each}}
                    </div>
{{#if other}}
                    {{!-- This page in the other language: its name in its own language --}}
                    <a href="{{other.path}}" hreflang="{{other.lang}}" class="lang-toggle-btn btn d-flex align-items-center gap-3 px-3 py-2 w-100">
                        {{icon "language" "icon-nav"}}
                        <span class="sr-only" lang="{{other.lang}}">{{other.name}}</span>
                        <span class="lang-options" aria-hidden="true">{{#each languages}}{{#unless @first}}<span class="lang-sep">/</span>{{/unless}}<span class="lang-opt{{#if active}} active{{/if}}">{{label}}</span>{{/each}}</span>
                    </a>
{{/if}}
                </div>
            </div>
        </nav>

        <main id="app-content" tabindex="-1">
{{#if suggestion}}
            {{!-- Offered once (by /js/core/shell.js) to someone whose browser
            prefers the other language and hasn't chosen one: in that language --}}
            <div class="lang-suggest" lang="{{other.lang}}" hidden>
                <a href="{{other.path}}" hreflang="{{other.lang}}">{{suggestion.text}}</a>
                <button type="button" class="lang-suggest-close" aria-label="{{suggestion.close}}">{{icon "close"}}</button>
            </div>
{{/if}}
{{{content}}}
{{#if ad}}
            {{!-- After the page's content, never inside it (server/ads.js) --}}
            <aside class="ad-slot" aria-labelledby="ad-label">
                <p class="ad-label" id="ad-label">{{t "ads.label"}}</p>
                <ins class="adsbygoogle ad-unit" data-ad-client="{{ad.client}}" data-ad-slot="{{ad.slot}}"></ins>
            </aside>
{{/if}}
        </main>

    </div>

    <!-- Bottom nav (mobile): home (the logo), the tools, and the menu button by the right thumb -->
    <nav id="bottom-nav" class="d-grid d-md-none fixed-bottom border-top" aria-label="{{t "nav.main"}}">
        <a href="/" class="nav-btn btn d-flex flex-column align-items-center py-2{{#if home}} active{{/if}}"{{#if home}} aria-current="page"{{/if}}>{{> logo width=33 height=24 class="nav-logo"}}<span class="nav-label">{{t "nav.home"}}</span></a>
{{#each tools}}
        <a href="{{path}}" data-tool="{{id}}" class="nav-btn btn d-flex flex-column align-items-center py-2{{#if active}} active{{/if}}"{{#if active}} aria-current="page"{{/if}}>{{#if active}}{{icon iconName "icon-nav" filled=true}}{{else}}{{icon iconName "icon-nav"}}{{/if}}<span class="nav-label">{{t shortKey}}</span></a>
{{/each}}
        {{!-- Opens the menu: a popover, so the browser opens and closes it (Esc,
        a tap outside) and moves the keyboard into it and back without a script.
        Only the icon shows; screen readers hear its name. --}}
        <button type="button" class="nav-btn menu-btn btn d-flex flex-column align-items-center py-2" popovertarget="site-menu" aria-label="{{t "nav.menu"}}">{{icon "menu" "icon-nav"}}</button>
    </nav>
    <nav id="site-menu" class="site-menu d-md-none" popover aria-label="{{t "nav.menu"}}">
{{#if other}}
            <a href="{{other.path}}" hreflang="{{other.lang}}" lang="{{other.lang}}" class="site-menu-link menu-language">{{icon "language"}}<span>{{other.name}}</span></a>
{{/if}}
{{#each siteLinks}}
            <a href="{{href}}" class="site-menu-link">{{icon iconName}}<span>{{t textKey}}</span></a>
{{/each}}
            {{> theme-switch}}
    </nav>

    <!-- Live region for screen reader announcements (visually hidden) -->
    <div id="sr-announcer" aria-live="polite" aria-atomic="true" class="sr-only"></div>

    <script type="application/json" id="strings">{{json strings}}</script>
    <!-- Bootstrap without Popper: the pages use its collapse (accordions) and toast -->
    <script src="/vendor/bootstrap/js/bootstrap.min.js" defer></script>
    <script type="module" src="/js/core/shell.js"></script>
{{#each scripts}}
    <script type="module" src="{{this}}"></script>
{{/each}}
</body>
</html>
