{
  "name": "wayhop",
  "version": "1.0.0",
  "private": true,
  "description": "Getting around Athens by public transport: metro trips, live bus arrivals and service information, in English and Greek",
  "homepage": "https://wayhop.gr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adiamandouros/move.git"
  },
  "bugs": {
    "url": "https://github.com/adiamandouros/move/issues"
  },
  "author": "adiamandouros",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server --watch-path=tools --watch-path=public/js --watch-path=public/css server.js",
    "build:data": "node server/data/index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "diagnose": "node scripts/diagnose.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.8.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "node-unrar-js": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
