<div class="subway-view trip-view">
    <h1 class="sr-only">{{t "tool.trip.title"}}</h1>
    <form id="trip-form" class="subway-form" role="search" autocomplete="off">
        {{!-- From and To as one block: each label small inside its row, My location
              on From's, the swap button beside both (DESIGN.md, "From and To") --}}
        <div class="place-pair">
            <div class="place-field">
                <div class="place-row">
                    <div class="place-input subway-search-wrap">
                        <label for="trip-from" class="place-label">{{t "trip.from"}}</label>
                        <input id="trip-from" class="place-control" type="search"
                               role="combobox" aria-autocomplete="list" aria-controls="trip-from-list" aria-expanded="false"
                               placeholder="{{t "trip.placeholder"}}">
                        <ul id="trip-from-list" class="stop-suggestions list-unstyled mb-0" role="listbox"
                            aria-label="{{t "trip.places-found"}}" hidden></ul>
                    </div>
                    <button id="trip-locate" type="button" class="place-btn locate-toggle" aria-pressed="false" title="{{t "trip.my-location"}}">
                        {{icon "nearest"}}<span class="sr-only">{{t "trip.my-location"}}</span>
                    </button>
                </div>
                <p id="trip-from-status" class="locate-status" role="status"></p>
            </div>

            <div class="place-field">
                <div class="place-row">
                    <div class="place-input subway-search-wrap">
                        <label for="trip-to" class="place-label">{{t "trip.to"}}</label>
                        <input id="trip-to" class="place-control" type="search"
                               role="combobox" aria-autocomplete="list" aria-controls="trip-to-list" aria-expanded="false"
                               placeholder="{{t "trip.placeholder"}}">
                        <ul id="trip-to-list" class="stop-suggestions list-unstyled mb-0" role="listbox"
                            aria-label="{{t "trip.places-found"}}" hidden></ul>
                    </div>
                </div>
                <p id="trip-to-status" class="locate-status" role="status"></p>
            </div>

            <button id="trip-swap" type="button" class="place-btn swap-btn"
                    title="{{t "trip.swap"}}" aria-label="{{t "trip.swap"}}">
                {{icon "swap"}}
            </button>
        </div>
    </form>

    <div id="trip-live-status" class="trip-live-status" role="status" hidden></div>
    <div id="trip-result"></div>

    <p class="trip-credit">{{t "trip.addresses-from"}} {{#external href="https://www.openstreetmap.org/copyright"}}OpenStreetMap{{/external}}</p>
</div>
