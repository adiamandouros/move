<div class="nearby-buses-view">
    <h1 class="sr-only">{{t "tool.buses.title"}}</h1>
    <div id="bus-status" class="bus-status" role="status" hidden></div>
    <div id="bus-message" aria-live="polite"></div>
    <div id="stops-accordion" class="accordion accordion-flush"></div>
    <div id="bus-actions" class="filter-bar" hidden>
        <button id="show-more-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4">{{t "buses.show-more"}}</button>
        <button id="toggle-empty-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4" aria-pressed="false">
            {{icon "eye-slash" "me-2"}}<span>{{t "buses.hide-empty"}}</span>
        </button>
    </div>
</div>
