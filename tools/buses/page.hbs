<div class="nearby-buses-view">
    <h1 class="sr-only">{{t "tool.buses.title"}}</h1>
    <form id="bus-search" class="bus-search" role="search">
        <label for="bus-search-input" class="form-label bus-search-label">{{t "buses.search-label"}}</label>
        <input id="bus-search-input" type="search" class="form-control bus-search-input" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="{{t "buses.search-placeholder"}}">
        <p id="search-status" class="search-status" role="status"></p>
    </form>
    <div id="search-results" class="search-results" hidden></div>
    <div id="bus-view">
        <h2 id="nearby-heading" class="search-heading nearby-heading" hidden>{{t "buses.nearby"}}</h2>
        <div id="view-header" class="view-header" hidden></div>
        <div id="bus-status" class="bus-status" role="status" hidden></div>
        <div id="bus-message" aria-live="polite"></div>
        <div id="stops-accordion" class="accordion accordion-flush"></div>
        <div id="bus-actions" class="filter-bar" hidden>
            <button id="show-more-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4">{{t "buses.show-more"}}</button>
            <button id="toggle-empty-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4" aria-pressed="false">
                {{icon "eye-slash" "me-2"}}<span>{{t "buses.hide-empty"}}</span>
            </button>
        </div>
    </div>
</div>
