<div class="subway-view">
    <h1 class="sr-only">{{t "tool.subway.title"}}</h1>
    <form id="subway-form" class="subway-form" role="search" autocomplete="off">
        <div class="subway-search-wrap mb-1">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <label for="stop-search-from" class="form-label fw-semibold m-0">{{t "subway.boarding-label"}}</label>
                <button id="locate-btn" type="button" class="btn btn-sm locate-btn">
                    {{icon "crosshair"}}<span>{{t "subway.nearest"}}</span>
                </button>
            </div>
            <div class="d-flex align-items-stretch gap-2">
            <div class="position-relative flex-grow-1">
                <input id="stop-search-from" class="form-control subway-search-input" type="search"
                       role="combobox" aria-autocomplete="list" aria-controls="stop-suggestions-from" aria-expanded="false"
                       placeholder="{{t "subway.boarding-placeholder"}}">
                <ul id="stop-suggestions-from" class="stop-suggestions list-unstyled mb-0" role="listbox"
                    aria-label="{{t "subway.station-suggestions"}}" hidden></ul>
            </div>
            {{!-- Its address and station are filled in by the page's script --}}
            {{#external id="walk-btn" class="directions-btn walk-btn" hidden=true}}
                {{icon "signpost-2-fill"}}
                <span class="sr-only">{{t "subway.walking-directions-to"}} <span id="walk-station"></span></span>
            {{/external}}
            </div>
            <p id="locate-status" class="locate-status" role="status"></p>
        </div>

        <div class="swap-row">
            <button id="swap-stations" type="button" class="btn btn-sm swap-btn"
                    title="{{t "subway.swap"}}" aria-label="{{t "subway.swap"}}">
                {{icon "arrow-down-up"}}
            </button>
        </div>

        <div class="subway-search-wrap mb-1">
            <label for="stop-search-to" class="form-label fw-semibold m-0">{{t "subway.destination-label"}}</label>
            <div class="position-relative">
                <input id="stop-search-to" class="form-control subway-search-input" type="search"
                       role="combobox" aria-autocomplete="list" aria-controls="stop-suggestions-to" aria-expanded="false"
                       placeholder="{{t "subway.destination-placeholder"}}">
                <ul id="stop-suggestions-to" class="stop-suggestions list-unstyled mb-0" role="listbox"
                    aria-label="{{t "subway.station-suggestions"}}" hidden></ul>
            </div>
        </div>
    </form>

    <div id="subway-result"></div>

    <p class="station-index-link small"><a href="/subway/stations">{{t "subway.all-stations"}}</a></p>
</div>
