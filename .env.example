PORT=3000
# Optional: contact address sent in the User-Agent to OASA, so they can reach you instead of blocking
CONTACT_EMAIL=
# Password for the private station editor at /admin/stations. Leave empty to disable it.
ADMIN_PASSWORD=
# Relay for reaching OASA, whose live API only accepts Greek IPs: the home relay or the
# Cloudflare Worker in proxy/ (see proxy/README.md). Both must be set to enable it.
OASA_RELAY_URL=
OASA_RELAY_KEY=
