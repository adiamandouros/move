PORT=3000
# The public address, without a trailing slash (e.g. https://move.gr). Used for
# canonical URLs, the sitemap and link previews; leave empty in development.
SITE_URL=
# Optional: contact address sent in the User-Agent to OASA, so they can reach you instead of blocking
CONTACT_EMAIL=
# Password for the private station editor at /admin/stations. Leave empty to disable it.
ADMIN_PASSWORD=
# Relays for reaching OASA, whose live API only accepts Greek IPs (see proxy/README.md).
# Tried in order after direct access; each needs both its URL and key.
# 1. The Cloudflare Worker
OASA_RELAY_URL=
OASA_RELAY_KEY=
# 2. The home relay (e.g. a Raspberry Pi), the last resort
OASA_HOME_RELAY_URL=
OASA_HOME_RELAY_KEY=
