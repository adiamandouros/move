PORT=3000
# The public address, without a trailing slash (https://wayhop.gr in production). Used for
# canonical URLs, the sitemap and link previews; leave empty in development.
SITE_URL=
# Optional: contact address sent in the User-Agent to OASA, so they can reach you instead of blocking
CONTACT_EMAIL=
# Google AdSense (see server/ads.js). With only ADSENSE_CLIENT set, the site can
# pass AdSense's review (verification tag, /ads.txt) and the privacy page
# describes ads, but none are shown; each ADSENSE_SLOT_* turns on one ad unit.
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_INFO=
ADSENSE_SLOT_STATION=
# Password for the private station editor at /admin/stations. Leave empty to disable it.
ADMIN_PASSWORD=
# Relays for reaching OASA, whose live API only accepts Greek IPs (see proxy/README.md).
# Tried in order after direct access; each needs both its URL and key.
# 1. The Cloudflare Worker
OASA_RELAY_URL=
OASA_RELAY_KEY=
# 2. The home relay (e.g. a Raspberry Pi), the last resort
OASA_HOME_RELAY_URL=
OASA_HOME_RELAY_KEY=

# Content-Security-Policy (server/csp.js): "report-only" (the default)
# while it's tried out, so browsers only report what it would block (see
# /admin/diagnostics); "enforce" once a week goes by without reports that matter.
CSP_MODE=
